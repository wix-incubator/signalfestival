---
import Layout from "../layouts/Layout.astro";
import SuccessMessage from "../components/SuccessMessage.astro";
import Button from "../components/Button.astro";
---

<Layout
  title="Registration Successful | Signal Festival"
  description="Signal Festival registration confirmation."
>
  <div class="success-page site-shell">
    <SuccessMessage
      title="Pass signal received."
      message="Your registration has been sent through Wix Headless. The festival team can now review your pass details and follow up with confirmation steps."
    >
      <div class="success-actions">
        <a href="/" class="inline-block">
          <Button variant="primary">Return to Home</Button>
        </a>
      </div>
    </SuccessMessage>
  </div>
</Layout>
